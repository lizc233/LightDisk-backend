<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.star.mapper.FileMapper">

    <resultMap id="BaseResultMap" type="com.star.model.entity.File">
            <id property="id" column="id" />
            <result property="fileName" column="file_name" />
            <result property="storageId" column="storage_id" />
            <result property="userId" column="user_id" />
            <result property="folderId" column="folder_id" />
            <result property="downloadCount" column="download_count" />
            <result property="status" column="status" />
            <result property="deleteTime" column="delete_time" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>



    <update id="deleteRecycleStatus">
        UPDATE file SET status = 0 , delete_time = NOW()
        WHERE id IN
        <foreach item="item" index="index" collection="fileIds"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
        AND user_id = #{userId}
    </update>
    <update id="restoreFile">
        UPDATE file SET status = 1 , delete_time = NULL
        WHERE id IN
        <foreach item="item" index="index" collection="fileIds"
        open="(" separator="," close=")">
            #{item}
        </foreach>
        AND user_id = #{userId}
    </update>
    <delete id="deleteFile">
        DELETE FROM file
        WHERE id IN
        <foreach item="item" index="index" collection="fileIds"
        open="(" separator="," close=")">
            #{item}
        </foreach>
        AND user_id = #{userId}
    </delete>

</mapper>
